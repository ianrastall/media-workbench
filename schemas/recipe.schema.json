{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Media Workbench scaffold recipe v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "displayName", "status", "source", "adapterId", "runtimeProfileId", "operations", "minimumVramMiB", "notes"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "version": {"type": "string", "minLength": 1},
    "displayName": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "experimental", "verified"]},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "repoId", "revision"],
      "properties": {
        "provider": {"const": "huggingface"},
        "repoId": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "revision": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{40}$"}
      }
    },
    "adapterId": {"type": "string", "minLength": 1},
    "runtimeProfileId": {"type": ["string", "null"]},
    "operations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "minimumVramMiB": {"type": "integer", "minimum": 0},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
