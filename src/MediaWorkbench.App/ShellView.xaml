<UserControl x:Class="MediaWorkbench_App.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:MediaWorkbench.Core"
    xmlns:converters="using:MediaWorkbench_App.Converters">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <converters:LocalImageConverter x:Key="LocalImage" />
    </UserControl.Resources>
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="Header" Margin="20,0,160,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8B9;" FontSize="19" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Media Workbench" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.AppVersion}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
        <NavigationView x:Name="Navigation" Grid.Row="1" OpenPaneLength="220" PaneDisplayMode="Auto"
            IsBackButtonVisible="Collapsed" SelectionChanged="Navigate" IsSettingsVisible="True">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home" Icon="Home" IsSelected="True" />
                <NavigationViewItem Content="Discover" Tag="discover" Icon="Find" />
                <NavigationViewItem Content="Create" Tag="create" Icon="Edit" />
                <NavigationViewItem Content="Library" Tag="library" Icon="Library" />
                <NavigationViewItem Content="Tools" Tag="tools" Icon="Repair" />
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="Diagnostics" Tag="diagnostics" Icon="Help" />
            </NavigationView.MenuItems>
            <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="20" Margin="32,24,32,32" MaxWidth="1180" HorizontalAlignment="Stretch">
                    <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Style="{ThemeResource TitleLargeTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.PageDescription, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="920" HorizontalAlignment="Left" />
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="{x:Bind ViewModel.Notice, Mode=OneWay}" />

                    <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.IsHome, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Padding="20" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Components" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.NativeStatus, Mode=OneWay}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind ViewModel.WorkerStatus, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <Button Content="Check components" Command="{x:Bind ViewModel.DiagnosticsCommand}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Padding="20" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Your workspace" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.DataRoot, Mode=OneWay}" TextWrapping="Wrap" />
                                    <TextBlock Text="Manage the data folder in Settings. Model files and media stay separate from application updates." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button Content="Open data folder" Command="{x:Bind ViewModel.OpenDataFolderCommand}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Padding="20" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Updates" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.UpdateText, Mode=OneWay}" TextWrapping="Wrap" />
                                <ScrollViewer MaxHeight="200" Visibility="{x:Bind ViewModel.HasUpdate, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                                    <TextBlock Text="{x:Bind ViewModel.UpdateNotes, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </ScrollViewer>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Content="Update now" Command="{x:Bind ViewModel.InstallUpdateCommand}" Style="{ThemeResource AccentButtonStyle}" Visibility="{x:Bind ViewModel.HasUpdate, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                                    <Button Content="Check for updates" Command="{x:Bind ViewModel.CheckForUpdatesCommand}" />
                                </StackPanel>
                                <TextBlock Text="Updating downloads the new installer from GitHub, checks it against its published checksum, then closes and reopens Media Workbench. Your models, images, and settings are kept." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="First model pipeline" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Open Create to install Stable Diffusion 1.5, verify your GPU, and generate your first image." TextWrapping="Wrap" />
                        <Button Content="Preview installation plan" Command="{x:Bind ViewModel.PlanCommand}" />
                        <TextBlock Text="{x:Bind ViewModel.PlanText, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsDiscover, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Search Hugging Face" PlaceholderText="Model name or publisher" MaxLength="200" />
                            <ComboBox Grid.Column="1" Header="Task" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.TaskIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="All tasks" Tag="" />
                                <ComboBoxItem Content="Text to image" Tag="text-to-image" />
                                <ComboBoxItem Content="Image to image" Tag="image-to-image" />
                                <ComboBoxItem Content="Text to video" Tag="text-to-video" />
                                <ComboBoxItem Content="Image to video" Tag="image-to-video" />
                            </ComboBox>
                            <Button Grid.Column="2" Content="Search" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.SearchCommand}" Style="{ThemeResource AccentButtonStyle}" />
                        </Grid>
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                            <ListView ItemsSource="{x:Bind ViewModel.Models}" SelectedItem="{x:Bind ViewModel.SelectedModel, Mode=TwoWay}" SelectionMode="Single"
                                MaxHeight="580" MinHeight="260" AutomationProperties.Name="Hugging Face search results" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="core:HubModel">
                                        <StackPanel Spacing="5" Padding="8,12">
                                            <TextBlock Text="{x:Bind Id}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind Stats}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{x:Bind Hint}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind License}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Grid.Column="1" Spacing="12">
                                <TextBlock Text="Model details" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <StackPanel Spacing="8">
                                    <Button Content="Check model" Command="{x:Bind ViewModel.DetailsCommand}" />
                                    <Button Content="Model card / license" Command="{x:Bind ViewModel.OpenModelCommand}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.HubPlanText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <CheckBox IsChecked="{x:Bind ViewModel.HubLicenseReviewed, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
                                    <TextBlock Text="I reviewed the publisher's model card and license." TextWrapping="Wrap" />
                                </CheckBox>
                                <Button Content="Download and test" Command="{x:Bind ViewModel.DownloadModelCommand}" Style="{ThemeResource AccentButtonStyle}" />
                                <Expander Header="Advanced options" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="12">
                                        <ComboBox Header="Model file" ItemsSource="{x:Bind ViewModel.HubFiles}" SelectedItem="{x:Bind ViewModel.SelectedHubFile, Mode=TwoWay}" DisplayMemberPath="Label" HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
                                        <Button Content="Check this file" Command="{x:Bind ViewModel.CheckHubFileCommand}" />
                                        <TextBox Text="{x:Bind ViewModel.DetailsText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" MaxHeight="260" AutomationProperties.Name="Selected model details" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsCreate, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}"
                        AllowDrop="True" DragOver="AcceptPictureDrag" Drop="DropPicture">
                        <!-- Once ready, setup shrinks to one line so Create is about the picture, not the plumbing. -->
                        <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.ModelReady, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                            <FontIcon Glyph="&#xE73E;" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Stable Diffusion 1.5 is installed and verified on this computer." VerticalAlignment="Center" TextWrapping="Wrap" />
                            <HyperlinkButton Content="Check again" Command="{x:Bind ViewModel.RefreshInstallationCommand}" />
                        </StackPanel>
                        <InfoBar IsOpen="{x:Bind ViewModel.HasRuntimeNote, Mode=OneWay}" IsClosable="False" Severity="Informational"
                            Message="{x:Bind ViewModel.RuntimeNote, Mode=OneWay}" Visibility="{x:Bind ViewModel.ModelReady, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                        <RadioButtons Header="What to make" ItemsSource="{x:Bind ViewModel.CreateKindLabels}" SelectedIndex="{x:Bind ViewModel.CreateKindIndex, Mode=TwoWay}" MaxColumns="2"
                            Visibility="{x:Bind ViewModel.ModelReady, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
                        <Border Padding="20" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Visibility="{x:Bind ViewModel.NeedsVideoSetup, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Set up short videos" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.VideoText, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Videos use Stable Diffusion 1.5 with AnimateDiff motion layers to make 2- or 3-second clips. Setup downloads 1.7 GB into the data folder and makes a short test video on your graphics card. On a 6 GB card that test, and each video, can take several minutes." />
                                <HyperlinkButton Content="AnimateDiff motion adapter (Apache-2.0)" NavigateUri="https://huggingface.co/guoyww/animatediff-motion-adapter-v1-5-3" Padding="0" />
                                <Button Content="Set up videos" Command="{x:Bind ViewModel.InstallVideoCommand}" Style="{ThemeResource AccentButtonStyle}" />
                            </StackPanel>
                        </Border>
                        <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsPictureMode, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                        <!-- The chooser appears only once a model the user added has passed its test. -->
                        <ComboBox Header="Model" ItemsSource="{x:Bind ViewModel.ModelChoices}" SelectedIndex="{x:Bind ViewModel.ModelIndex, Mode=TwoWay}" Width="360"
                            Visibility="{x:Bind ViewModel.HasModelChoice, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="core:ModelChoice">
                                    <TextBlock Text="{x:Bind Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Expander Header="Get Stable Diffusion XL for larger, more detailed pictures" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Visibility="{x:Bind ViewModel.NeedsXlSetup, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                            <StackPanel Spacing="12">
                                <TextBlock TextWrapping="Wrap" Text="Stable Diffusion XL makes 1024-pixel pictures with more detail and better composition than Stable Diffusion 1.5. Setup downloads 6.9 GB into the data folder and makes a test picture on your graphics card before you can choose it under Model. It uses the runtime already installed." />
                                <TextBlock Text="{x:Bind ViewModel.XlText, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="On graphics cards with 6 GB, or without reliable half precision, the model streams to the card layer by layer: it fits, but each picture can take several minutes, and full precision needs 16 GB of system memory." />
                                <HyperlinkButton Content="Model card and CreativeML Open RAIL++-M license" NavigateUri="https://huggingface.co/stabilityai/stable-diffusion-xl-base-1.0" Padding="0" />
                                <Button Content="Set up Stable Diffusion XL" Command="{x:Bind ViewModel.InstallXlCommand}" Style="{ThemeResource AccentButtonStyle}" />
                            </StackPanel>
                        </Expander>
                        <Expander Header="Add a model you already downloaded" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Visibility="{x:Bind ViewModel.ModelReady, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                            <StackPanel Spacing="12">
                                <TextBlock TextWrapping="Wrap" Text="Use a Stable Diffusion 1.5-family model you downloaded elsewhere: one .safetensors file, or a Diffusers model folder. Media Workbench copies it into your data folder (your original stays where it is), checks the copy, and tests it on your GPU before you can choose it. Nothing is downloaded." />
                                <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.HasNoImportCandidate, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                                    <Button Content="Choose a model file…" Click="ChooseModelFile" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
                                    <Button Content="Choose a model folder…" Click="ChooseModelFolder" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.ImportText, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasImportCandidate, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                                    <TextBox Header="Name" Text="{x:Bind ViewModel.ImportName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" Width="360" HorizontalAlignment="Left" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button Content="Add and test" Command="{x:Bind ViewModel.ImportModelCommand}" Style="{ThemeResource AccentButtonStyle}" />
                                        <Button Content="Choose another" Command="{x:Bind ViewModel.CancelImportCommand}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="Only .safetensors files are accepted: older .ckpt files can run hidden code when opened. Follow the license on the page you downloaded the model from. Remove added models in Settings." />
                            </StackPanel>
                        </Expander>
                        </StackPanel>
                        <Border Padding="20" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Visibility="{x:Bind ViewModel.NeedsSetup, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Set up Stable Diffusion 1.5" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.InstallationText, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.SystemProfileText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                    Visibility="{x:Bind ViewModel.HasSystemProfile, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                                <TextBlock Text="Setup downloads about 5 GiB plus dependency files. Allow 20 GiB free for the runtime, model, and cache. NVIDIA GPU with 6 GB VRAM required. Downloads stay in the data folder shown in Settings." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <HyperlinkButton Content="Model card and CreativeML Open RAIL-M license" NavigateUri="https://huggingface.co/stable-diffusion-v1-5/stable-diffusion-v1-5" Padding="0" />
                                <InfoBar Title="Where should Media Workbench work?" Severity="Informational" IsClosable="False"
                                    IsOpen="{x:Bind ViewModel.NeedsDriveChoice, Mode=OneWay}" Message="{x:Bind ViewModel.DriveChoiceText, Mode=OneWay}">
                                    <InfoBar.ActionButton>
                                        <Button Content="Keep this drive" Command="{x:Bind ViewModel.KeepDataDriveCommand}" />
                                    </InfoBar.ActionButton>
                                </InfoBar>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Content="Install / verify" Command="{x:Bind ViewModel.InstallCommand}" Style="{ThemeResource AccentButtonStyle}" />
                                    <Button Content="Check model status" Command="{x:Bind ViewModel.RefreshInstallationCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsPictureMode, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                            <TextBlock Text="Start from a picture (optional)" />
                            <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.HasNoSourceImage, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                                <Button Content="Choose a picture…" Click="ChoosePicture" />
                                <TextBlock Text="or drag one here. Leave empty to create from your description alone." VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Grid ColumnSpacing="16" Visibility="{x:Bind ViewModel.HasSourceImage, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Image Source="{x:Bind ViewModel.SourceImagePath, Mode=OneWay, Converter={StaticResource LocalImage}, ConverterParameter=160}" Width="160" Height="160" Stretch="Uniform" AutomationProperties.Name="Starting picture"
                                    Visibility="{x:Bind ViewModel.IsChangingWholePicture, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.SourceImageName, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsChangingWholePicture, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                                        <ComboBox Header="How much to change it" ItemsSource="{x:Bind ViewModel.ChangeLabels}" SelectedIndex="{x:Bind ViewModel.ChangeIndex, Mode=TwoWay}" Width="200" />
                                        <TextBlock Text="The result keeps your picture's proportions (square, portrait, or landscape). To change only one part, paint over it instead." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox Header="How much to change the painted part" ItemsSource="{x:Bind ViewModel.PaintChangeLabels}" SelectedIndex="{x:Bind ViewModel.PaintChangeIndex, Mode=TwoWay}" Width="260"
                                        Visibility="{x:Bind ViewModel.IsPainting, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Paint the part to change" Click="StartPainting" Visibility="{x:Bind ViewModel.IsChangingWholePicture, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                                        <Button Content="Choose another…" Click="ChoosePicture" />
                                        <Button Content="Remove picture" Command="{x:Bind ViewModel.ClearStartingPictureCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <!-- Painting: the canvas has the mask's cell size and the Viewbox scales it, so pointer positions map straight to cells. -->
                            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsPainting, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                                <TextBlock Text="Paint over the part to change, then describe what should be there. Everything you don't paint stays exactly as it is, at its full size." TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox ItemsSource="{x:Bind ViewModel.BrushLabels}" SelectedIndex="{x:Bind ViewModel.BrushIndex, Mode=TwoWay}" Width="160" AutomationProperties.Name="Brush size" />
                                    <ToggleButton Content="Erase" IsChecked="{x:Bind ViewModel.IsErasing, Mode=TwoWay}" />
                                    <Button Content="Clear painting" Command="{x:Bind ViewModel.ClearPaintingCommand}" />
                                    <Button Content="Change the whole picture" Command="{x:Bind ViewModel.StopPaintingCommand}" />
                                </StackPanel>
                                <Viewbox MaxWidth="640" MaxHeight="512" HorizontalAlignment="Left" Stretch="Uniform">
                                    <Grid x:Name="PaintSurface" Background="Transparent" PointerPressed="PaintPressed" PointerMoved="PaintMoved" PointerReleased="PaintReleased" PointerExited="PaintExited" AutomationProperties.Name="Starting picture; paint over the part to change">
                                        <Image Source="{x:Bind ViewModel.SourceImagePath, Mode=OneWay, Converter={StaticResource LocalImage}, ConverterParameter=1024}" Stretch="Fill" />
                                        <Image x:Name="PaintOverlay" Stretch="Fill" IsHitTestVisible="False" />
                                        <Canvas IsHitTestVisible="False">
                                            <Ellipse x:Name="BrushOutline" Stroke="White" StrokeThickness="1" Visibility="Collapsed" />
                                        </Canvas>
                                    </Grid>
                                </Viewbox>
                            </StackPanel>
                        </StackPanel>
                        <TextBox Header="{x:Bind ViewModel.PromptHeader, Mode=OneWay}" Text="{x:Bind ViewModel.Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxLength="2000" />
                        <TextBox Header="Things to avoid (optional)" PlaceholderText="For example: blurry, text, extra fingers" Text="{x:Bind ViewModel.NegativePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <ComboBox Header="Shape" ItemsSource="{x:Bind ViewModel.SizeLabels}" SelectedIndex="{x:Bind ViewModel.SizeIndex, Mode=TwoWay}" Width="260" Visibility="{x:Bind ViewModel.ShowsShape, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                            <ComboBox Header="Length" ItemsSource="{x:Bind ViewModel.VideoLengthLabels}" SelectedIndex="{x:Bind ViewModel.VideoLengthIndex, Mode=TwoWay}" Width="260" Visibility="{x:Bind ViewModel.IsVideoMode, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                        </StackPanel>
                        <Expander Header="Advanced options" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="16">
                                <TextBlock Text="The defaults work well. Change these only if you want to fine-tune a result." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <NumberBox Header="Seed" Value="{x:Bind ViewModel.Seed, Mode=TwoWay}" Minimum="0" Maximum="4294967295" Width="200" SpinButtonPlacementMode="Compact" />
                                    <NumberBox Header="Refinement steps" Value="{x:Bind ViewModel.Steps, Mode=TwoWay}" Minimum="1" Maximum="50" Width="160" SpinButtonPlacementMode="Compact" />
                                    <NumberBox Header="Prompt strength" Value="{x:Bind ViewModel.GuidanceScale, Mode=TwoWay}" Minimum="1" Maximum="20" SmallChange="0.5" LargeChange="2" Width="160" SpinButtonPlacementMode="Compact" />
                                </StackPanel>
                                <ComboBox Header="Sampling method" ItemsSource="{x:Bind ViewModel.SamplerLabels}" SelectedIndex="{x:Bind ViewModel.SamplerIndex, Mode=TwoWay}" Width="360" Visibility="{x:Bind ViewModel.IsPictureMode, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="The same seed with the same settings repeats an image; change it for a new variation. More steps add detail but take longer. Higher prompt strength follows your words more literally; lower is looser and more natural." />
                            </StackPanel>
                        </Expander>
                        <InfoBar Title="The data folder's drive is nearly full" Severity="Warning" IsClosable="False"
                            IsOpen="{x:Bind ViewModel.HasDriveWarning, Mode=OneWay}" Message="{x:Bind ViewModel.DriveWarning, Mode=OneWay}" />
                        <!-- Before setup, the setup card already gives this advice with the hardware summary. -->
                        <InfoBar Severity="Informational" IsClosable="True" IsOpen="{x:Bind ViewModel.HasDriveSpeedNote, Mode=OneWay}" Message="{x:Bind ViewModel.DriveSpeedNote, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ModelReady, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                        <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsVideoMode, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                            <Button Content="Make video" Command="{x:Bind ViewModel.GenerateVideoCommand}" Style="{ThemeResource AccentButtonStyle}" />
                            <MediaPlayerElement x:Name="VideoPlayer" AreTransportControlsEnabled="True" MaxWidth="512" MaxHeight="512" HorizontalAlignment="Left"
                                Visibility="{x:Bind ViewModel.HasLatestVideo, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="Generated video preview" />
                            <TextBlock Text="{x:Bind ViewModel.VideoDescription, Mode=OneWay}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.HasLatestVideo, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                                <Button Content="Open video" Command="{x:Bind ViewModel.OpenVideoCommand}" CommandParameter="{x:Bind ViewModel.VideoPreviewPath, Mode=OneWay}" />
                                <Button Content="Save a copy…" Tag="{x:Bind ViewModel.LatestVideo, Mode=OneWay}" Click="SaveImageCopy" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsPictureMode, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                        <Button Content="Generate image" Command="{x:Bind ViewModel.GenerateCommand}" Style="{ThemeResource AccentButtonStyle}" />
                        <Image Source="{x:Bind ViewModel.PreviewPath, Mode=OneWay, Converter={StaticResource LocalImage}}" MaxWidth="512" MaxHeight="512" HorizontalAlignment="Left" Stretch="Uniform" AutomationProperties.Name="Generated image preview" />
                        <TextBlock Text="{x:Bind ViewModel.ImageDescription, Mode=OneWay}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Use as starting picture" Command="{x:Bind ViewModel.UseAsStartingPictureCommand}" CommandParameter="{x:Bind ViewModel.PreviewPath, Mode=OneWay}" />
                            <Button Content="Make it bigger" Command="{x:Bind ViewModel.UseForUpscaleCommand}" CommandParameter="{x:Bind ViewModel.PreviewPath, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.HasLatestImage, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                            <Button Content="Open image" Command="{x:Bind ViewModel.OpenImageCommand}" CommandParameter="{x:Bind ViewModel.PreviewPath, Mode=OneWay}" />
                            <Button Content="Save a copy…" Tag="{x:Bind ViewModel.LatestImage, Mode=OneWay}" Click="SaveImageCopy" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
                        </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsLibrary, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                        <StackPanel Spacing="12">
                            <TextBox Header="Find a picture or video" PlaceholderText="Prompt, seed, or job ID" Text="{x:Bind ViewModel.LibrarySearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" MaxWidth="640" HorizontalAlignment="Stretch" KeyDown="SearchLibraryOnEnter" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <ComboBox Header="Show" ItemsSource="{x:Bind ViewModel.LibraryKindLabels}" SelectedIndex="{x:Bind ViewModel.LibraryKindIndex, Mode=TwoWay}" Width="200" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
                                <Button Content="Search / refresh" Command="{x:Bind ViewModel.RefreshLibraryCommand}" VerticalAlignment="Bottom" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.LibraryText, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Newer images" Command="{x:Bind ViewModel.PreviousLibraryPageCommand}" />
                            <Button Content="Older images" Command="{x:Bind ViewModel.NextLibraryPageCommand}" />
                        </StackPanel>
                        <!-- ItemsRepeater virtualizes against the page's ScrollViewer; thumbnails decode at display size. -->
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Images}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="360" MinColumnSpacing="16" MinRowSpacing="16" ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="core:GeneratedImage">
                                    <Border Padding="16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <StackPanel Spacing="12">
                                            <Image Source="{x:Bind ImagePath, Converter={StaticResource LocalImage}, ConverterParameter=320}" Width="320" Height="320" HorizontalAlignment="Left" Stretch="Uniform" AutomationProperties.Name="{x:Bind Settings.Prompt}" />
                                            <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ImagePath}" IsTextSelectionEnabled="True" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind IsPicture, Converter={StaticResource VisibleWhenTrue}}">
                                                <Button Content="Use as starting picture" Tag="{x:Bind ImagePath}" Click="UseLibraryPicture" />
                                                <Button Content="Make it bigger" Tag="{x:Bind ImagePath}" Click="UpscaleLibraryPicture" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="Use settings" Tag="{x:Bind}" Click="UseImageSettings" IsEnabled="{x:Bind CanReuseSettings}" />
                                                <Button Content="Open image" Tag="{x:Bind ImagePath}" Click="OpenLibraryImage" Visibility="{x:Bind IsPicture, Converter={StaticResource VisibleWhenTrue}}" />
                                                <Button Content="Play video" Tag="{x:Bind VideoPath}" Click="OpenLibraryVideo" Visibility="{x:Bind IsVideo, Converter={StaticResource VisibleWhenTrue}}" />
                                                <Button Content="Save a copy…" Tag="{x:Bind}" Click="SaveImageCopy" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Newer images" Command="{x:Bind ViewModel.PreviousLibraryPageCommand}" />
                            <Button Content="Older images" Command="{x:Bind ViewModel.NextLibraryPageCommand}" />
                        </StackPanel>
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasProblems, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                            <TextBlock Text="Unfinished generations" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="Recent generations that failed, were cancelled, or stopped when the app closed. No image was saved for these." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Problems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:JobSummary">
                                        <Grid Padding="16" Margin="0,0,0,8" CornerRadius="10" ColumnSpacing="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Content="Use settings" Tag="{x:Bind}" Click="RetryJob" IsEnabled="{x:Bind CanRetry}" />
                                                <Button Content="Open log" Tag="{x:Bind}" Click="OpenJobLog" IsEnabled="{x:Bind HasLog}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsSettings, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                        <TextBox IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" Text="{x:Bind ViewModel.DataRootDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Data folder" PlaceholderText="Choose an absolute folder path" />
                        <TextBlock Text="Models, private inference environments, media, caches and temporary work use this folder, so choose a drive with plenty of room. A new path takes effect when you save settings; it does not move existing files." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Save settings" Command="{x:Bind ViewModel.SaveSettingsCommand}" Style="{ThemeResource AccentButtonStyle}" />
                            <Button Content="Move my data there…" Command="{x:Bind ViewModel.CheckMoveCommand}" />
                            <Button Content="Open folder" Command="{x:Bind ViewModel.OpenDataFolderCommand}" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="Save settings starts using the new folder as it is. Move my data there copies your pictures, videos, models and setup into it first and checks every file, so nothing has to download again." />
                        <InfoBar Title="The old copy of your data" Severity="Informational" IsClosable="False" IsOpen="{x:Bind ViewModel.HasOldCopy, Mode=OneWay}" Message="{x:Bind ViewModel.OldCopyText, Mode=OneWay}">
                            <InfoBar.ActionButton>
                                <Button Content="Remove the old copy…">
                                    <Button.Flyout>
                                        <Flyout>
                                            <StackPanel Spacing="12" MaxWidth="320">
                                                <TextBlock TextWrapping="Wrap" Text="Deletes the files in the old folder that the new data folder holds unchanged. This cannot be undone. Files that differ, or that were added later, are kept." />
                                                <Button Content="Remove" Command="{x:Bind ViewModel.RemoveOldCopyCommand}" Style="{ThemeResource AccentButtonStyle}" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <InfoBar Title="Move your data" Severity="Informational" IsClosable="False" IsOpen="{x:Bind ViewModel.HasMovePlan, Mode=OneWay}" Message="{x:Bind ViewModel.MovePlanText, Mode=OneWay}">
                            <InfoBar.ActionButton>
                                <Button Content="Move now" Command="{x:Bind ViewModel.MoveDataCommand}" Style="{ThemeResource AccentButtonStyle}" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <TextBlock Text="Drives on this computer" FontWeight="SemiBold" Visibility="{x:Bind ViewModel.HasDrives, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Drives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:DriveChoice">
                                    <Grid Padding="16,10" Margin="0,0,0,6" CornerRadius="10" ColumnSpacing="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Use this drive" Tag="{x:Bind}" Click="UseDrive" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Where Media Workbench keeps things" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                        <TextBlock Text="{x:Bind ViewModel.LocationsText, Mode=OneWay}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Locations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:StorageLocation">
                                    <StackPanel Spacing="2" Padding="16,10" Margin="0,0,0,6" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Path}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Storage" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                        <TextBlock Text="{x:Bind ViewModel.StorageText, Mode=OneWay}" TextWrapping="Wrap" />
                        <InfoBar Title="The data folder's drive is nearly full" Severity="Warning" IsClosable="False"
                            IsOpen="{x:Bind ViewModel.HasDriveWarning, Mode=OneWay}" Message="{x:Bind ViewModel.DriveWarning, Mode=OneWay}" />
                        <InfoBar Severity="Informational" IsClosable="False" IsOpen="{x:Bind ViewModel.HasDriveSpeedNote, Mode=OneWay}" Message="{x:Bind ViewModel.DriveSpeedNote, Mode=OneWay}" />
                        <CheckBox Content="Keep setup's download files for repairs (about 4 GB)" IsChecked="{x:Bind ViewModel.KeepDownloadCaches, Mode=TwoWay}" />
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="Media Workbench tidies up after itself. Once setup passes its test, it removes the packages and archives it downloaded (a repair downloads them again if needed). At each start it removes unfinished downloads older than three days, logs beyond the newest 300 or older than 30 days, and failed or stopped jobs beyond the 50 that Library lists. Images, their records, the pictures Use settings needs, and your own files are never removed." />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.StorageItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:StorageItem">
                                    <Grid Padding="16,12" Margin="0,0,0,8" CornerRadius="10" ColumnSpacing="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind SizeText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind Note}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind HasNote, Converter={StaticResource VisibleWhenTrue}}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Clear…" VerticalAlignment="Center" Visibility="{x:Bind Clearable, Converter={StaticResource VisibleWhenTrue}}">
                                            <Button.Flyout>
                                                <Flyout>
                                                    <StackPanel Spacing="12" MaxWidth="320">
                                                        <TextBlock Text="{x:Bind Note}" TextWrapping="Wrap" />
                                                        <Button Content="Clear now" Tag="{x:Bind Id}" Click="ClearStorage" Style="{ThemeResource AccentButtonStyle}" />
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasAddedModels, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                            <TextBlock Text="Models you added" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.AddedModels}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:ModelChoice">
                                        <Grid Padding="16,12" Margin="0,0,0,8" CornerRadius="10" ColumnSpacing="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" IsTextSelectionEnabled="True" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Content="Test again" Tag="{x:Bind}" Click="RetestModel" Visibility="{x:Bind NeedsTest, Converter={StaticResource VisibleWhenTrue}}" />
                                                <Button Content="Remove…">
                                                    <Button.Flyout>
                                                        <Flyout>
                                                            <StackPanel Spacing="12" MaxWidth="320">
                                                                <TextBlock TextWrapping="Wrap" Text="Removes this model's copy from the data folder. Your images, their records, and your original file are kept." />
                                                                <Button Content="Remove" Tag="{x:Bind}" Click="RemoveModel" Style="{ThemeResource AccentButtonStyle}" />
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Measure storage" Command="{x:Bind ViewModel.RefreshStorageCommand}" />
                            <Button Content="Remove Stable Diffusion 1.5…" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
                                <Button.Flyout>
                                    <Flyout>
                                        <StackPanel Spacing="12" MaxWidth="360">
                                            <TextBlock TextWrapping="Wrap" Text="Removes the private runtime, the model files (including Stable Diffusion XL and the video motion adapter), and download caches from the saved data folder. Your images, videos, their records, and models you added are kept; added models work again after setup. Setting it up again downloads about 5 GiB." />
                                            <Button Content="Remove" Tag="installation" Click="ClearStorage" Style="{ThemeResource AccentButtonStyle}" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Stable Diffusion XL" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.XlSettingsText, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Content="Remove Stable Diffusion XL…" IsEnabled="{x:Bind ViewModel.XlReady, Mode=OneWay}">
                                <Button.Flyout>
                                    <Flyout>
                                        <StackPanel Spacing="12" MaxWidth="360">
                                            <TextBlock TextWrapping="Wrap" Text="Removes Stable Diffusion XL (about 6.9 GB) from the data folder. Pictures you made with it are kept. Setting it up again downloads and tests it again." />
                                            <Button Content="Remove" Click="RemoveXl" Style="{ThemeResource AccentButtonStyle}" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Short videos" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.VideoSettingsText, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Content="Remove video setup…" IsEnabled="{x:Bind ViewModel.VideoReady, Mode=OneWay}">
                                <Button.Flyout>
                                    <Flyout>
                                        <StackPanel Spacing="12" MaxWidth="360">
                                            <TextBlock TextWrapping="Wrap" Text="Removes the AnimateDiff motion adapter (about 1.7 GB) from the data folder. Videos you made are kept. Setting videos up again downloads and tests it again." />
                                            <Button Content="Remove" Click="RemoveVideo" Style="{ThemeResource AccentButtonStyle}" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <CheckBox Content="Check for updates when Media Workbench starts (needs internet; nothing installs without your click)" IsChecked="{x:Bind ViewModel.CheckForUpdates, Mode=TwoWay}" />
                        <Expander Header="Connect an LLM client (MCP)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <TextBlock Text="A compatible desktop LLM client can use Media Workbench as a local tool. Add this configuration to that client's MCP settings. Your LLM account stays in the client; prompts, image settings, and tool results can be shared with its provider. This does not expose an Internet endpoint." TextWrapping="Wrap" />
                                <CheckBox Content="Include permission to install / verify and set up videos (downloads several GiB and tests the GPU)" IsChecked="{x:Bind ViewModel.McpAllowSetup, Mode=TwoWay}" />
                                <CheckBox Content="Include permission to make pictures, upscales, and videos with the verified setup" IsChecked="{x:Bind ViewModel.McpAllowInference, Mode=TwoWay}" />
                                <TextBlock Text="Both permissions are off by default. These choices only change the configuration below; restart the client's MCP server to apply a changed configuration. It always uses your saved data folder." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox Text="{x:Bind ViewModel.McpConfiguration, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="260" FontFamily="Consolas" AutomationProperties.Name="MCP client configuration" />
                                <Button Content="Copy MCP configuration" Click="CopyMcpConfiguration" />
                            </StackPanel>
                        </Expander>
                        <TextBlock Text="Dark mode" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Media Workbench currently uses the dark Windows theme. No account credentials are stored in this alpha." TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsDiagnostics, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                        <Button Content="Run diagnostics" Command="{x:Bind ViewModel.DiagnosticsCommand}" Style="{ThemeResource AccentButtonStyle}" />
                        <TextBlock Text="This computer" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.SystemProfileDetails, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Text="Components" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBox Text="{x:Bind ViewModel.DiagnosticsText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="200" AutomationProperties.Name="Component diagnostics" />
                    </StackPanel>

                    <Border Padding="24" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Visibility="{x:Bind ViewModel.IsPlanned, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                        <StackPanel Spacing="16" AllowDrop="True" DragOver="AcceptPictureDrag" Drop="DropUpscalePicture">
                            <TextBlock Text="Make a picture bigger and sharper" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.NeedsSetup, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                                <TextBlock Text="The upscaler is installed and tested together with Stable Diffusion 1.5." VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Button Content="Set up in Create" Command="{x:Bind ViewModel.GoToCreateCommand}" />
                            </StackPanel>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="160" Height="160" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <Image Source="{x:Bind ViewModel.UpscaleSourcePath, Mode=OneWay, Converter={StaticResource LocalImage}, ConverterParameter=160}" Stretch="Uniform" AutomationProperties.Name="Picture to enlarge" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.UpscaleSourceName, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <Button Content="Choose a picture…" Click="ChooseUpscalePicture" />
                                    <TextBlock Text="Or drag a picture here, or select Make it bigger on a Library image. Pictures up to 2048 pixels on the longest side." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                            <ComboBox Header="How much bigger" ItemsSource="{x:Bind ViewModel.UpscaleLabels}" SelectedIndex="{x:Bind ViewModel.UpscaleIndex, Mode=TwoWay}" Width="200" />
                            <InfoBar Title="The data folder's drive is nearly full" Severity="Warning" IsClosable="False"
                                IsOpen="{x:Bind ViewModel.HasDriveWarning, Mode=OneWay}" Message="{x:Bind ViewModel.DriveWarning, Mode=OneWay}" />
                            <Button Content="Make it bigger" Command="{x:Bind ViewModel.UpscaleCommand}" Style="{ThemeResource AccentButtonStyle}" />
                            <Image Source="{x:Bind ViewModel.UpscalePreviewPath, Mode=OneWay, Converter={StaticResource LocalImage}, ConverterParameter=768}" MaxWidth="768" MaxHeight="768" HorizontalAlignment="Left" Stretch="Uniform" AutomationProperties.Name="Enlarged picture" />
                            <TextBlock Text="{x:Bind ViewModel.UpscaleDescription, Mode=OneWay}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.HasLatestUpscale, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                                <Button Content="Open image" Command="{x:Bind ViewModel.OpenImageCommand}" CommandParameter="{x:Bind ViewModel.UpscalePreviewPath, Mode=OneWay}" />
                                <Button Content="Save a copy…" Tag="{x:Bind ViewModel.LatestUpscale, Mode=OneWay}" Click="SaveImageCopy" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Session activity" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Activity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Margin="0,3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </NavigationView>
        <Grid Grid.Row="2" Padding="24,10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="18" Height="18" />
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <ProgressBar IsIndeterminate="{x:Bind ViewModel.ProgressIndeterminate, Mode=OneWay}" Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" Maximum="100" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
            </StackPanel>
            <Button Grid.Column="2" Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}" />
        </Grid>
    </Grid>
</UserControl>
