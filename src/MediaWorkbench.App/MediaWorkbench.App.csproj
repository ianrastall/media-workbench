<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>MediaWorkbench_App</RootNamespace>
    <AssemblyName>MediaWorkbench</AssemblyName>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Product>Media Workbench</Product>
    <Description>Local media creation workspace</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>AnyCPU;x64</Platforms>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <EnableWinAppRunSupport>false</EnableWinAppRunSupport>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <ProjectReference Include="../MediaWorkbench.Infrastructure/MediaWorkbench.Infrastructure.csproj" />
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\workers\python\*.py" Link="workers\python\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\recipes\*.json" Link="recipes\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\runtime\python\**\*" Link="runtime\python\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTES.md" Link="THIRD-PARTY-NOTES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\WINDOWS-APP-SDK-LICENSE.txt" Link="WINDOWS-APP-SDK-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\**\*" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>
  <Target Name="CopyUnpackagedXamlToPublish" AfterTargets="Publish">
    <ItemGroup>
      <WorkbenchXbf Include="$(TargetDir)**\*.xbf" />
      <WorkbenchPri Include="$(TargetDir)$(AssemblyName).pri" />
    </ItemGroup>
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="The generated application PRI is missing." />
    <Copy SourceFiles="@(WorkbenchXbf)" DestinationFiles="@(WorkbenchXbf->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(WorkbenchPri)" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
